# Geopram Technologies — canonical environment template
# Add real values in Vercel Project Settings → Environment Variables. Never commit real secrets.

# Core application / database
MONGODB_URI=
DATABASE_NAME=GEOPRAMTECHNOLOGIES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PATH=/your-private-admin-path
SESSION_SECRET=
COOKIE_SECURE=true
KENYA_ONLY_MODE=false

# Company details
COMPANY_NAME=Geopram Technologies
COMPANY_EMAIL=info@geopratech.co.ke
COMPANY_PHONE=0702781490
COMPANY_ADDRESS=Nyeri, Kenya
CURRENCY=KES

# SMTP email (Gmail: use an app password, not your normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Geopram Technologies <info@geopratech.co.ke>

# Safaricom Daraja / M-Pesa STK Push
CONSUMER_KEY=
CONSUMER_SECRET=
SHORTCODE=
PASSKEY=
CALLBACK_URL=https://geopram-technologies.vercel.app/api/callback
# Optional if your implementation uses a separate till number
MPESA_TILL_NUMBER=

# Africa's Talking SMS
SMS_PROVIDER=africastalking
SMS_ENVIRONMENT=sandbox
SMS_USERNAME=sandbox
SMS_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
